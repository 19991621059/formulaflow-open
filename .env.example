# 仅在服务端读取。也可留空，启动后在页面中临时填写模型连接。
# 填到 /v1（或供应商对应的 API 根路径），不需要 /chat/completions。
MODEL_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_API_KEY=
MODEL_NAME=glm-5.3-flash
MODEL_TIMEOUT_MS=120000
# auto：智谱接口启用 thinking；其他兼容接口不传 thinking 参数。
# 若供应商不兼容，可设置 off；on 会传入 {type:"enabled"}。
MODEL_THINKING=auto

# 自己的本地模型（Ollama / vLLM）需要显式启用；默认禁止访问私有地址。
# Docker 内请使用容器可访问的主机名，而不是容器内的 127.0.0.1。
MODEL_ALLOW_PRIVATE_HOSTS=false

# 默认启动在 127.0.0.1，仅供本机使用。
# 若开放到局域网或互联网，请设置较长访问口令，并通过 HTTPS 访问。
APP_ACCESS_TOKEN=
# 反向代理环境若 Host / 协议未被正确保留，可明确填写浏览器访问的完整 Origin。
APP_PUBLIC_ORIGIN=
